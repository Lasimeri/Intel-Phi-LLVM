diff --git a/llvm/lib/Target/X86/X86.td b/llvm/lib/Target/X86/X86.td
index b724a12d2..9fc33a425 100644
--- a/llvm/lib/Target/X86/X86.td
+++ b/llvm/lib/Target/X86/X86.td
@@ -133,6 +133,13 @@ def FeatureEVEX512  : SubtargetFeature<"evex512", "HasEVEX512", "true",
 def FeatureAVX512   : SubtargetFeature<"avx512f", "X86SSELevel", "AVX512",
                                       "Enable AVX-512 instructions",
                                       [FeatureAVX2, FeatureFMA, FeatureF16C]>;
+// Intel Phi 3120A project: the Knights Corner vector unit (512-bit MVEX
+// encoding, Intel Xeon Phi Coprocessor ISA reference 327364). Outside the
+// X86SSELevel ladder on purpose: "avx512f" implies AVX2 and SSE, which
+// Knights Corner does not execute (ISA 327364, appendix B). No instruction
+// uses it yet; the MVEX definitions are a later patch.
+def FeatureKNC     : SubtargetFeature<"knc", "HasKNC", "true",
+                                      "Enable the Knights Corner vector unit (MVEX)">;
 def FeatureCDI      : SubtargetFeature<"avx512cd", "HasCDI", "true",
                       "Enable AVX-512 Conflict Detection Instructions",
                                       [FeatureAVX512]>;
@@ -1530,6 +1537,12 @@ def ProcessorFeatures {
   list<SubtargetFeature> KNMFeatures =
     !listconcat(KNLFeatures, [FeatureVPOPCNTDQ]);
 
+  // Knights Corner (Xeon Phi x100; Intel Phi 3120A project): the x86-64
+  // baseline without CMOV, MMX, SSE/SSE2 and the 0F 1F NOPs, which the core
+  // does not execute (ISA 327364, appendix B), plus the vector unit.
+  list<SubtargetFeature> KNCFeatures = [FeatureX87, FeatureCX8, FeatureFXSR,
+                                        FeatureX86_64, FeatureKNC];
+
   // Barcelona
   list<SubtargetFeature> BarcelonaFeatures = [FeatureX87,
                                               FeatureCX8,
@@ -2081,6 +2094,17 @@ foreach P = ["knl", "mic_avx512"] in {
   def : ProcModel<P, HaswellModel, ProcessorFeatures.KNLFeatures,
                   ProcessorFeatures.KNLTuning>;
 }
+// Knights Corner keeps the scheduling model and tuning that -march=x86-64
+// gets (X86TargetMachine::getSubtargetImpl tunes "x86-64" as "generic"),
+// so its scalar code is what -march=x86-64 minus the deleted instructions
+// gives. A model of the in-order KNC core would be separate, measured work.
+def : ProcModel<"knc", SandyBridgeModel, ProcessorFeatures.KNCFeatures,
+                [TuningSlow3OpsLEA,
+                 TuningSlowDivide64,
+                 TuningMacroFusion,
+                 TuningFastScalarFSQRT,
+                 TuningFast15ByteNOP,
+                 TuningInsertVZEROUPPER]>;
 def : ProcModel<"knm", HaswellModel, ProcessorFeatures.KNMFeatures,
                 ProcessorFeatures.KNLTuning>;
 
diff --git a/llvm/lib/Target/X86/X86Subtarget.cpp b/llvm/lib/Target/X86/X86Subtarget.cpp
index ed2da3128..10d366133 100644
