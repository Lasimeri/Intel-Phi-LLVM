+++ b/llvm/lib/Target/X86/X86Subtarget.cpp
@@ -256,6 +256,11 @@ void X86Subtarget::initSubtargetFeatures(StringRef CPU, StringRef TuneCPU,
 
   std::string FullFS = X86_MC::ParseX86Triple(TargetTriple);
   assert(!FullFS.empty() && "Failed to parse X86 triple");
+  // Intel Phi 3120A project: the triple's implicit "+sse2" is applied after
+  // the CPU's own features and would turn SSE back on for "knc", which has
+  // no SSE (ISA 327364, appendix B).
+  if (CPU == "knc")
+    FullFS = X86_MC::dropTripleSSE2(FullFS);
 
   if (!FS.empty())
     FullFS = (Twine(FullFS) + "," + FS).str();
