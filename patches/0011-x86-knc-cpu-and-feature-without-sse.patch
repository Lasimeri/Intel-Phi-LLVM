@@ -62,6 +62,14 @@ std::string X86_MC::ParseX86Triple(const Triple &TT) {
   return FS;
 }
 
+std::string X86_MC::dropTripleSSE2(StringRef FS) {
+  std::string S = FS.str();
+  size_t P = S.find(",+sse2");
+  if (P != std::string::npos)
+    S.erase(P, 6);
+  return S;
+}
+
 unsigned X86_MC::getDwarfRegFlavour(const Triple &TT, bool isEH) {
   if (TT.isX86_64())
     return DWARFFlavour::X86_64;
@@ -459,6 +467,9 @@ MCSubtargetInfo *X86_MC::createX86MCSubtargetInfo(const Triple &TT,
                                                   StringRef CPU, StringRef FS) {
   std::string ArchFS = X86_MC::ParseX86Triple(TT);
   assert(!ArchFS.empty() && "Failed to parse X86 triple");
+  // Intel Phi 3120A project: no implicit SSE2 for "knc" (see X86Subtarget).
+  if (CPU == "knc")
+    ArchFS = dropTripleSSE2(ArchFS);
   if (!FS.empty())
     ArchFS = (Twine(ArchFS) + "," + FS).str();
 
