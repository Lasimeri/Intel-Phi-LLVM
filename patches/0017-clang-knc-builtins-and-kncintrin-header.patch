diff --git a/clang/lib/Sema/SemaX86.cpp b/clang/lib/Sema/SemaX86.cpp
index cfd71d366..8bfd1ba27 100644
--- a/clang/lib/Sema/SemaX86.cpp
+++ b/clang/lib/Sema/SemaX86.cpp
@@ -551,6 +551,41 @@ bool SemaX86::CheckBuiltinFunctionCall(const TargetInfo &TI, unsigned BuiltinID,
   if (CheckBuiltinTileArguments(BuiltinID, TheCall))
     return true;
 
+  // Knights Corner: an imm8 must fit in 8 bits, and an MVEX.E/SSS decoration
+  // must be one that the instruction form's tables allow (327364 chapter 2;
+  // the sets come from knc-gen).
+  {
+    struct KNCImm {
+      unsigned ID;
+      unsigned char Arg, Kind;
+      unsigned short Allowed;
+    };
+    static const KNCImm KNCImms[] = {
+#include "SemaX86KNC.inc"
+    };
+    bool IsKNC = false;
+    for (const KNCImm &K : KNCImms) {
+      if (K.ID != BuiltinID)
+        continue;
+      IsKNC = true;
+      if (K.Kind == 0) {
+        if (SemaRef.BuiltinConstantArgRange(TheCall, K.Arg, 0, 255))
+          return true;
+        continue;
+      }
+      llvm::APSInt V;
+      if (SemaRef.BuiltinConstantArg(TheCall, K.Arg, V))
+        return true;
+      if (V.isNegative() || V.getZExtValue() > 15 ||
+          !((K.Allowed >> V.getZExtValue()) & 1))
+        return Diag(TheCall->getBeginLoc(), diag::err_argument_invalid_range)
+               << toString(V, 10) << 0 << 15
+               << TheCall->getArg(K.Arg)->getSourceRange();
+    }
+    if (IsKNC)
+      return false;
+  }
+
   // For intrinsics which take an immediate value as part of the instruction,
   // range check them here.
   int i = 0, l = 0, u = 0;
