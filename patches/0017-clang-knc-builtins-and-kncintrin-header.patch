diff --git a/clang/lib/Headers/kncintrin.h b/clang/lib/Headers/kncintrin.h
new file mode 100644
index 000000000..f8dfeeb3b
--- /dev/null
+++ b/clang/lib/Headers/kncintrin.h
@@ -0,0 +1,488 @@
+/*===---- kncintrin.h - Knights Corner intrinsics --------------------------===
+ *
+ * Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+ * See https://llvm.org/LICENSE.txt for license information.
+ * SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+ *
+ *===-----------------------------------------------------------------------===
+ *
+ * The vector unit of Knights Corner (Xeon Phi x100) under -march=knc, with
+ * Intel's names and prototypes for it (Intel Intrinsics Guide data 3.5.3,
+ * the last to list KNC; Intel C++ Compiler reference, "Intrinsics for Intel
+ * MIC Architecture"). Each one is a __builtin_ia32_knc_* builtin: one builtin
+ * per instruction form of Intel's 327364-001 (generated, see knc-gen).
+ *
+ * Intel's documentation names the enumerations below but gives no values.
+ * Here each value is the instruction's own encoding (MVEX.SSS), so code that
+ * uses the names works and code that passes raw numbers may not.
+ *
+ * __m512 arguments are passed in memory under -march=knc, as clang does for
+ * every 512-bit vector without AVX-512 (the vector ABI is an open decision);
+ * these functions are always inlined, so a kernel built from them never
+ * passes one.
+ *
+ *===-----------------------------------------------------------------------===
+ */
+#ifndef __IMMINTRIN_H
+#error "Never use <kncintrin.h> directly; include <immintrin.h> instead."
+#endif
+
+#ifndef __KNCINTRIN_H
+#define __KNCINTRIN_H
+
+typedef float __m512 __attribute__((__vector_size__(64), __aligned__(64)));
+typedef double __m512d __attribute__((__vector_size__(64), __aligned__(64)));
+typedef long long __m512i __attribute__((__vector_size__(64), __aligned__(64)));
+typedef unsigned short __mmask16;
+typedef unsigned char __mmask8;
+
+typedef float __v16sf __attribute__((__vector_size__(64)));
+typedef int __v16si __attribute__((__vector_size__(64)));
+typedef double __v8df __attribute__((__vector_size__(64)));
+typedef long long __v8di __attribute__((__vector_size__(64)));
