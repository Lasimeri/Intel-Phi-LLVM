diff --git a/llvm/lib/Target/X86/MCTargetDesc/X86KNCInfo.cpp b/llvm/lib/Target/X86/MCTargetDesc/X86KNCInfo.cpp
new file mode 100644
index 000000000..75688a661
--- /dev/null
+++ b/llvm/lib/Target/X86/MCTargetDesc/X86KNCInfo.cpp
@@ -0,0 +1,108 @@
+//===-- X86KNCInfo.cpp - Knights Corner instruction table -----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "X86KNCInfo.h"
+#include "X86MCTargetDesc.h"
+#include "llvm/MC/MCInst.h"
+#include <algorithm>
+#include <vector>
+
+using namespace llvm;
+using namespace llvm::X86KNC;
+
+namespace {
+#include "X86KNCInfo.inc"
+} // namespace
+
+ArrayRef<Insn> X86KNC::getAllInsns() { return ArrayRef(Insns); }
+
+ArrayRef<Insn> X86KNC::lookupMnemonic(StringRef Mnemonic) {
+  auto Range = std::equal_range(
+      std::begin(Insns), std::end(Insns), Mnemonic,
+      [](const auto &A, const auto &B) {
+        auto Name = [](const auto &X) -> StringRef {
+          if constexpr (std::is_same_v<std::decay_t<decltype(X)>, Insn>)
+            return X.Mnemonic;
+          else
+            return X;
+        };
+        return Name(A) < Name(B);
+      });
+  return ArrayRef<Insn>(Range.first, Range.second);
+}
+
+const Insn *X86KNC::lookupOpcode(unsigned Opcode) {
+  // Built once: the table is sorted by mnemonic, the opcode index by opcode.
+  static const std::vector<uint16_t> ByOpcode = [] {
+    std::vector<uint16_t> V(std::size(Insns));
+    for (unsigned I = 0; I != V.size(); ++I)
+      V[I] = I;
+    std::sort(V.begin(), V.end(), [](uint16_t A, uint16_t B) {
+      return Insns[A].Opcode < Insns[B].Opcode;
+    });
+    return V;
+  }();
+  auto It = std::lower_bound(
+      ByOpcode.begin(), ByOpcode.end(), Opcode,
+      [](uint16_t I, unsigned Opc) { return Insns[I].Opcode < Opc; });
+  if (It == ByOpcode.end() || Insns[*It].Opcode != Opcode)
+    return nullptr;
+  return &Insns[*It];
+}
+
+const PseudoOp *X86KNC::lookupPseudo(StringRef Mnemonic) {
+  for (const PseudoOp &P : PseudoOps)
+    if (Mnemonic == P.Pseudo)
+      return &P;
+  return nullptr;
+}
+
+const PseudoOp *X86KNC::findPseudo(StringRef Base, unsigned Imm) {
+  for (const PseudoOp &P : PseudoOps)
+    if (Base == P.Base && Imm == P.Imm)
+      return &P;
+  return nullptr;
+}
+
+const DecoTable &X86KNC::getDecoTable(unsigned Index) {
+  return DecoTables[Index];
+}
+
+int X86KNC::findDeco(const DecoTable &T, StringRef Tok) {
+  if (Tok.empty())
+    return (T.Valid & 1) ? 0 : -1;
+  if ((T.Valid & 1) && Tok == T.Alias)
+    return 0;
+  for (int S = 0; S != 8; ++S)
+    if ((T.Valid >> S & 1) && Tok == T.Tok[S])
+      return S;
+  return -1;
+}
+
+bool X86KNC::hasSSSOperand(unsigned Opcode) {
+  const Insn *I = lookupOpcode(Opcode);
+  return I && I->SSSMI >= 0;
+}
+
+unsigned X86KNC::getMVEXBits(const MCInst &MI) {
+  const Insn *I = lookupOpcode(MI.getOpcode());
+  if (!I)
+    return 0;
+  unsigned Bits = I->SSSMI >= 0 ? MI.getOperand(I->SSSMI).getImm() & 15 : 0;
+  if (I->EH != 2)
+    Bits = (Bits & 7) | I->EH << 3;
+  return Bits;
+}
+
+unsigned X86KNC::getDisp8Scale(const MCInst &MI) {
+  const Insn *I = lookupOpcode(MI.getOpcode());
+  if (!I || !I->MVEX || !I->MemTab)
+    return 0;
+  unsigned N = DecoTables[I->MemTab].N[getMVEXBits(MI) & 7];
+  return N ? N : 1;
+}
diff --git a/llvm/lib/Target/X86/MCTargetDesc/X86KNCInfo.h b/llvm/lib/Target/X86/MCTargetDesc/X86KNCInfo.h
new file mode 100644
index 000000000..b99d3813f
--- /dev/null
+++ b/llvm/lib/Target/X86/MCTargetDesc/X86KNCInfo.h
@@ -0,0 +1,130 @@
+//===-- X86KNCInfo.h - Knights Corner instruction table ---------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The Knights Corner (Xeon Phi x100, K1OM) vector instructions: the MVEX
+// prefix (62h with P1 bit 2 clear) and the KNC VEX mask and scalar forms.
+// One table, generated from Intel's instruction set reference (327364-001),
+// describes every form: its operands in Intel order, the encoding field each
+// operand goes to, its MCInst position, and the swizzle, conversion and
+// rounding decorations it accepts with the disp8*N of each memory
+// conversion. The assembler, the instruction printers, the code emitter and
+// the disassembler all read it, so the syntax and the encoding cannot drift
+// apart.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_X86_MCTARGETDESC_X86KNCINFO_H
+#define LLVM_LIB_TARGET_X86_MCTARGETDESC_X86KNCINFO_H
+
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/ADT/StringRef.h"
+#include <cstdint>
+
+namespace llvm {
+class MCInst;
+
+namespace X86KNC {
+
+/// Operand kinds.
+enum OperandKind : uint8_t {
+  K_VR,   ///< zmm0-zmm31
+  K_KR,   ///< k0-k7
+  K_GR32, ///< 32-bit general register
+  K_GR64, ///< 64-bit general register
+  K_MEM,  ///< memory (five MCInst operands)
+  K_VSIB, ///< memory with a zmm index (gather, scatter)
+  K_IMM,  ///< imm8
+  K_M8,   ///< byte memory (prefetch, cache-line evict)
+};
+
+/// The encoding field an operand goes to.
+enum OperandRole : uint8_t { R_NONE, R_REG, R_VVVV, R_RM, R_IMM };
+
+/// Operand flags.
+enum : uint8_t {
+  F_MASK = 1, ///< carries the {k} write mask
+  F_CONV = 2, ///< carries the swizzle or conversion decoration
+  F_EH = 4,   ///< accepts the {eh} eviction hint
+  F_HALF = 8, ///< a register source read as its low half, written ymm
+  F_MASKREQ = 16, ///< the write mask must be written (gathers, scatters)
+};
+
+struct OperandDesc {
+  uint8_t Kind;
+  uint8_t Role;
+  uint8_t MI; ///< MCInst operand index (the first of five for memory)
+  uint8_t Flags;
+};
+
+/// One decoration table: the spelling of each MVEX.SSS value (empty for the
+/// default), the disp8*N of a memory conversion, the valid values, and the
+/// document's spelling of the default ({16to16}, {8to8}, {dcba}).
+struct DecoTable {
+  const char *Tok[8];
+  uint8_t N[8];
+  uint8_t Valid;
+  const char *Alias;
+};
+
+struct Insn {
+  unsigned Opcode;
+  const char *Mnemonic;
+  uint8_t MVEX;  ///< 1 MVEX, 0 VEX
+  uint8_t Map;   ///< 1 0F, 2 0F38, 3 0F3A
+  uint8_t PP;    ///< 0 none, 1 66, 2 F3, 3 F2
+  uint8_t W;     ///< 0, 1, or 2 when W is ignored
+  uint8_t Opc;   ///< opcode byte
+  uint8_t ModRM; ///< ModRM.reg opcode extension 0-7, or 8 for /r
+  uint8_t EH;    ///< MVEX.E fixed by the opcode (0, 1), or 2 when free
+  int8_t MaskMI; ///< MCInst index of the write mask, or -1
+  int8_t SSSMI;  ///< MCInst index of the E << 3 | SSS operand, or -1
+  uint8_t MemTab;  ///< decorations of the memory operand (up/down conv)
+  uint8_t Reg0Tab; ///< register swizzles (MVEX.E = 0)
+  uint8_t Reg1Tab; ///< rounding and SAE (MVEX.E = 1), 0 when not allowed
+  uint8_t Form;    ///< 0 SrcReg 1 SrcMem 2 DestMem 3 MRMnr 4 MRMnm
+  uint8_t NumOps;
+  OperandDesc Ops[5];
+
+  bool isMemForm() const { return Form == 1 || Form == 2 || Form == 4; }
+};
+
+/// A pseudo-op of the reference: vcmpeqps = vcmpps with immediate 0. Imm is
+/// 0xff for a pseudo-op that is another opcode outright (vpcmpnled).
+struct PseudoOp {
+  const char *Pseudo;
+  const char *Base;
+  uint8_t Imm;
+};
+
+/// The forms of a mnemonic, in matching order; empty when it is not a
+/// Knights Corner mnemonic.
+ArrayRef<Insn> lookupMnemonic(StringRef Mnemonic);
+/// The form of an opcode, or null when it is not a Knights Corner opcode.
+const Insn *lookupOpcode(unsigned Opcode);
+const PseudoOp *lookupPseudo(StringRef Mnemonic);
+/// The pseudo-op that prints a (base, immediate) pair, or null.
+const PseudoOp *findPseudo(StringRef Base, unsigned Imm);
+const DecoTable &getDecoTable(unsigned Index);
+ArrayRef<Insn> getAllInsns();
+
+/// MVEX.E << 3 | MVEX.SSS of an MCInst (the fixed E of vmovnr*/vmovnrngo*
+/// included).
+unsigned getMVEXBits(const MCInst &MI);
+/// The disp8*N scale of an MVEX memory form, from its conversion.
+unsigned getDisp8Scale(const MCInst &MI);
+/// True when the opcode carries a trailing E << 3 | SSS operand.
+bool hasSSSOperand(unsigned Opcode);
+
+/// Index of a decoration in a table (the alias of the default included);
+/// -1 when the table has no such decoration.
+int findDeco(const DecoTable &T, StringRef Tok);
+
+} // namespace X86KNC
+} // namespace llvm
+
+#endif
