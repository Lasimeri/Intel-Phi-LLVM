@@ -0,0 +1,940 @@
+//===- X86ScheduleKNC.td - X86 Knights Corner Scheduling ---*- tablegen -*-==//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The schedule class data for Knights Corner (the Xeon Phi x100 core): in
+// order, a U and a V pipe, and no instruction from the same thread in
+// consecutive cycles. The scalar part is the Atom model's (an in-order,
+// dual-issue x86 of the same lineage); the 512-bit vector classes that the
+// Knights Corner pseudos use (X86InstrKNCCodeGen.td, X86InstrKNCIntrin.td)
+// carry Intel's numbers for this core: vector operations 4 cycles, loads
+// and stores 7, conversions and shuffles 6, the vector unit on the U pipe.
+// The latency of an operation with a folded load is not given; 7 (the
+// load) is an estimate.
+//
+//===----------------------------------------------------------------------===//
+
+//
+
+// Knights Corner machine model.
+def KNCModel : SchedMachineModel {
+  let IssueWidth = 1;  // One thread issues at most every other cycle.
+  let MicroOpBufferSize = 0; // In-order execution, always hide latency.
+  let LoadLatency = 3; // Expected cycles, may be overriden.
+  let HighLatency = 30;// Expected, may be overriden.
+
+  // On the Atom, the throughput for taken branches is 2 cycles. For small
+  // simple loops, expand by a small factor to hide the backedge cost.
+  let LoopMicroOpBufferSize = 10;
+  let PostRAScheduler = 1;
+  let CompleteModel = 0;
+}
+
+let SchedModel = KNCModel in {
+
+// Functional Units
+def KNCPort0 : ProcResource<1>; // ALU: ALU0, shift/rotate, load/store
+                                 // SIMD/FP: SIMD ALU, Shuffle,SIMD/FP multiply, divide
+def KNCPort1 : ProcResource<1>; // ALU: ALU1, bit processing, jump, and LEA
+                                 // SIMD/FP: SIMD ALU, FP Adder
+
+// NOTE: This is for ops that can use EITHER port, not for ops that require BOTH ports.
+def KNCPort01 : ProcResGroup<[KNCPort0, KNCPort1]>;
