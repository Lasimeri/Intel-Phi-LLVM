-def : ProcModel<"knc", SandyBridgeModel, ProcessorFeatures.KNCFeatures,
+// Knights Corner keeps the tuning that -march=x86-64 gets (X86TargetMachine::
+// getSubtargetImpl tunes "x86-64" as "generic") and has its own scheduling
+// model (X86ScheduleKNC.td): the core is in order, and vector code that does
+// not hide the 4 to 7 cycles of latency runs at half speed (Intel-Phi-LLVM
+// tests/s3, bitunpack, measured on a card).
+def : ProcModel<"knc", KNCModel, ProcessorFeatures.KNCFeatures,
                 [TuningSlow3OpsLEA,
                  TuningSlowDivide64,
                  TuningMacroFusion,
