+def : Pat<(i64 (int_x86_knc_kconcatl_qkk GR16:$op1, GR16:$op2)),
+          (KNC_KCONCATL_qkk_P (COPY_TO_REGCLASS (i32 (INSERT_SUBREG (i32 (IMPLICIT_DEF)), GR16:$op1, sub_16bit)), VK16), (COPY_TO_REGCLASS (i32 (INSERT_SUBREG (i32 (IMPLICIT_DEF)), GR16:$op2, sub_16bit)), VK16))>;
+// KNC_KEXTRACT_kqi
