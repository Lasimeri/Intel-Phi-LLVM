+/// Knights Corner has no mask load or store (327364 section 2.1.3.3: kmov
+/// moves between mask and general purpose registers only), so a mask spill
+/// or reload carries a second, 8-byte slot. expandKNCMaskSpill uses it to
+/// keep %rax when no general purpose register is free.
+static MachineInstrBuilder addKNCScratchSlot(MachineInstrBuilder MIB) {
+  MachineFunction &MF = *MIB->getMF();
+  int FI = MF.getFrameInfo().CreateSpillStackObject(8, Align(8));
+  return addFrameReference(MIB, FI);
