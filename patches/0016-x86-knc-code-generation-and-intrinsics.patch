+/// Knights Corner: masks cross the IR as i16, so a mask carried around a loop
+/// is a GR16 PHI, and each use and definition pays a kmov to and from a k
+/// register. After selection, a web of GR16 PHIs whose incoming values are
+/// copies out of k registers or constants, and whose uses are copies back
+/// into k registers, is rebuilt as VK16 PHIs: the mask then stays in a k
+/// register, and a constant is moved in once, in its own block.
+///
+/// The shapes, as the KNC patterns select them:
+///   out of a k register:  %x:gr32 = COPY %k:vk16; %m:gr16 = COPY %x.sub_16bit
+///   into a k register:    %z:gr32 = INSERT_SUBREG %u, %m, sub_16bit;
+///                         %v:vk16[wm] = COPY %z   (all of %z's uses)
+static Register kncMaskSource(MachineRegisterInfo &MRI, Register M) {
+  MachineInstr *Def = MRI.getVRegDef(M);
+  if (!Def || !Def->isCopy() || Def->getOperand(1).getSubReg() != X86::sub_16bit)
+    return Register();
+  Register X = Def->getOperand(1).getReg();
+  if (!X.isVirtual())
+    return Register();
+  MachineInstr *XDef = MRI.getVRegDef(X);
+  if (!XDef || !XDef->isCopy() || XDef->getOperand(1).getSubReg())
+    return Register();
+  Register K = XDef->getOperand(1).getReg();
+  if (!K.isVirtual() || !X86::VK16RegClass.hasSubClassEq(MRI.getRegClass(K)))
+    return Register();
+  return K;
+}
+
+/// The COPYs into k registers that \p UseMI (an INSERT_SUBREG of the mask)
+/// feeds, or false when its result goes anywhere else.
+static bool kncMaskUses(MachineRegisterInfo &MRI, MachineInstr &UseMI,
+                        SmallVectorImpl<MachineInstr *> &Copies) {
+  if (!UseMI.isInsertSubreg() || UseMI.getOperand(3).getImm() != X86::sub_16bit)
+    return false;
+  for (MachineInstr &C : MRI.use_nodbg_instructions(UseMI.getOperand(0).getReg())) {
+    if (!C.isCopy() || C.getOperand(1).getSubReg() ||
+        !C.getOperand(0).getReg().isVirtual() ||
+        !X86::VK16RegClass.hasSubClassEq(
+            MRI.getRegClass(C.getOperand(0).getReg())))
+      return false;
+    Copies.push_back(&C);
+  }
+  return true;
+}
