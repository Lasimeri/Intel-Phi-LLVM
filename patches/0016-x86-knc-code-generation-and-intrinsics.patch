+def KNC_KEXTRACT_kqi_P : KNC_P<(outs VK16:$dst), (ins GR64:$op1, i32u8imm:$op2), []>;
+def : Pat<(i16 (int_x86_knc_kextract_kqi GR64:$op1, timm:$op2)),
+          (EXTRACT_SUBREG (i32 (COPY_TO_REGCLASS (KNC_KEXTRACT_kqi_P GR64:$op1, timm:$op2), GR32)), sub_16bit)>;
