+        else if (!kncMaskUses(MRI, U, Copies))
+          OK = false;
+      }
+    }
+    for (MachineInstr *P : Web)
+      Done.insert(P);
+    if (!OK)
+      continue;
+    // One VK16 PHI per GR16 PHI, then the incoming values and the uses.
+    DenseMap<MachineInstr *, Register> NewReg;
+    for (MachineInstr *P : Web)
+      NewReg[P] = MRI.createVirtualRegister(&X86::VK16RegClass);
+    for (MachineInstr *P : Web) {
+      MachineBasicBlock &MBB = *P->getParent();
+      auto MIB = BuildMI(MBB, P, P->getDebugLoc(), TII.get(TargetOpcode::PHI),
+                         NewReg[P]);
+      for (unsigned I = 1; I < P->getNumOperands(); I += 2) {
+        Register R = P->getOperand(I).getReg();
+        MachineBasicBlock *From = P->getOperand(I + 1).getMBB();
+        MachineInstr *D = MRI.getVRegDef(R);
+        Register In;
+        if (D && D->isPHI() && NewReg.count(D))
+          In = NewReg[D];
+        else if (Register K = kncMaskSource(MRI, R))
+          In = K;
+        else { // MOV16ri: into a k register where it is defined
+          MachineBasicBlock &DB = *D->getParent();
+          auto At = std::next(D->getIterator());
+          Register G = MRI.createVirtualRegister(&X86::GR32RegClass);
+          BuildMI(DB, At, D->getDebugLoc(), TII.get(X86::MOV32ri), G)
+              .addImm(D->getOperand(1).getImm() & 0xffff);
+          In = MRI.createVirtualRegister(&X86::VK16RegClass);
+          BuildMI(DB, At, D->getDebugLoc(), TII.get(TargetOpcode::COPY), In)
+              .addReg(G);
+        }
+        MIB.addReg(In).addMBB(From);
+      }
+    }
+    for (MachineInstr *C : Copies) {
+      MachineInstr *Ins = MRI.getVRegDef(C->getOperand(1).getReg());
+      MachineInstr *P = MRI.getVRegDef(Ins->getOperand(2).getReg());
+      C->getOperand(1).setReg(NewReg[P]);
+    }
+  }
+  // Every mask that came out of a k register and goes back into one: use the
+  // k register (the dead copies are left to dead-code elimination).
+  for (MachineBasicBlock &MBB : MF)
+    for (MachineInstr &MI : MBB) {
+      if (!MI.isInsertSubreg() || MI.getOperand(3).getImm() != X86::sub_16bit)
+        continue;
+      Register K = kncMaskSource(MRI, MI.getOperand(2).getReg());
+      SmallVector<MachineInstr *, 4> Copies;
+      if (!K || !kncMaskUses(MRI, MI, Copies))
+        continue;
+      for (MachineInstr *C : Copies)
+        C->getOperand(1).setReg(K);
+    }
