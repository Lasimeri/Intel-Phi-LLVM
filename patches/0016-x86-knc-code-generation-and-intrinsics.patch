+      if (!OnlyMasks)
+        continue;
+      Register G = MRI.createVirtualRegister(&X86::GR32RegClass);
+      BuildMI(MBB, MI, MI.getDebugLoc(), TII.get(X86::MOV32ri), G)
+          .addImm(MI.getOperand(1).getImm() & 0xffff);
+      for (MachineInstr *C : Copies)
+        C->getOperand(1).setReg(G);
+    }
+}
