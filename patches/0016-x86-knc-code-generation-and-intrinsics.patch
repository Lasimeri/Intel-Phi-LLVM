diff --git a/llvm/lib/Target/X86/X86InstrKNCCodeGen.td b/llvm/lib/Target/X86/X86InstrKNCCodeGen.td
new file mode 100644
index 000000000..6e622c5b4
--- /dev/null
+++ b/llvm/lib/Target/X86/X86InstrKNCCodeGen.td
@@ -0,0 +1,129 @@
+//===-- X86InstrKNCCodeGen.td - Knights Corner code generation -*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The code generation layer over the Knights Corner MC defs of
+// X86InstrKNC.td. Those defs describe the bytes: every one carries a mask
+// operand (k0 = no mask) and no tied operands, so as MachineInstrs they
+// would hide what a merge-masked or destructive instruction reads. Code
+// generation uses the pseudos below instead. Each pseudo states its real
+// operands and is turned into its MC def when the MCInst is built
+// (X86KNCLowering.cpp): an unmasked pseudo gets k0 inserted as its mask, a
+// merge-masked pseudo drops its tied pass-through operand.
+//
+// Under knc the 512-bit types v16f32, v16i32, v8f64 and v8i64 live in
+// VR512 and masks cross the IR as i16. Only moves are selected from
+// generic nodes here; the arithmetic comes from the llvm.x86.knc.*
+// intrinsics (X86InstrKNCIntrin.td).
+//
+//===----------------------------------------------------------------------===//
+
+// Marks a pseudo of this layer: TableGen backends that pair instructions by
+// encoding skip it, as they skip the MC defs.
+class KNC_P<dag outs, dag ins, list<dag> pattern>
+  : I<0, Pseudo, outs, ins, "", pattern>, KNCEnc;
+
+let Predicates = [HasKNC], isPseudo = 1, isCodeGenOnly = 1,
+    hasSideEffects = 0 in {
+
+// Register copy: vmovaps zmm1, zmm2 (copyPhysReg).
+let isMoveReg = 1, SchedRW = [WriteFMoveZ] in
+def KNC_MOVZ_rr : KNC_P<(outs VR512:$dst), (ins VR512:$src), []>;
+
+// Whole-register load and store, 64-byte aligned (vmovaps; KNC has no
+// unaligned full-width access).
+let mayLoad = 1, canFoldAsLoad = 1, isReMaterializable = 1,
+    SchedRW = [WriteFLoadY] in
+def KNC_MOVZ_rm : KNC_P<(outs VR512:$dst), (ins f512mem:$src), []>;
+let mayStore = 1, SchedRW = [WriteFStoreY] in
+def KNC_MOVZ_mr : KNC_P<(outs), (ins f512mem:$dst, VR512:$src), []>;
+
+// All zeros: vpxord zmm1, zmm1, zmm1.
+let isReMaterializable = 1, isAsCheapAsAMove = 1, SchedRW = [WriteZero] in
+def KNC_SET0 : KNC_P<(outs VR512:$dst), (ins),
+                     [(set VR512:$dst, (v16i32 immAllZerosV))]>;
+
+// Mask spill and reload. KNC has no mask load or store, so these go
+// through a general purpose register after register allocation
+// (X86InstrInfo::expandPostRAPseudo); $scratch is a slot that keeps that
+// register's value when none is free.
+let mayStore = 1, SchedRW = [WriteStore] in
+def KNC_SPILL_K : KNC_P<(outs), (ins i16mem:$dst, VK16:$src, i64mem:$scratch),
+                        []>;
+let mayLoad = 1, SchedRW = [WriteLoad] in
+def KNC_RELOAD_K : KNC_P<(outs VK16:$dst), (ins i16mem:$src, i64mem:$scratch),
+                         []>;
+
+} // Predicates = [HasKNC], isPseudo = 1
+
+foreach VT = [v16f32, v16i32, v8f64, v8i64] in {
+  let Predicates = [HasKNC] in {
+    def : Pat<(VT (alignedload512 addr:$src)), (KNC_MOVZ_rm addr:$src)>;
+    def : Pat<(alignedstore512 (VT VR512:$src), addr:$dst),
+              (KNC_MOVZ_mr addr:$dst, VR512:$src)>;
+  }
+}
+
+let Predicates = [HasKNC] in {
+  def : Pat<(v16f32 immAllZerosV), (KNC_SET0)>;
+  def : Pat<(v8f64 immAllZerosV), (KNC_SET0)>;
+  def : Pat<(v8i64 immAllZerosV), (KNC_SET0)>;
+
+  // The four types share VR512; a bitcast between them is free.
+  foreach DstVT = [v16f32, v16i32, v8f64, v8i64] in
+    foreach SrcVT = [v16f32, v16i32, v8f64, v8i64] in
+      if !ne(DstVT, SrcVT) then
+        def : Pat<(DstVT (bitconvert (SrcVT VR512:$src))), (DstVT VR512:$src)>;
+}
+
+// Broadcast of one element from memory: the splat of a scalar
+// (LowerKNCBuildVector stores it to the stack first).
+let Predicates = [HasKNC], isPseudo = 1, isCodeGenOnly = 1,
+    hasSideEffects = 0, mayLoad = 1, SchedRW = [WriteFLoadY] in {
+def KNC_BCST_SS : KNC_P<(outs VR512:$dst), (ins f32mem:$src),
+                        [(set VR512:$dst, (v16f32 (X86VBroadcastld32 addr:$src)))]>;
+def KNC_BCST_D : KNC_P<(outs VR512:$dst), (ins i32mem:$src),
+                       [(set VR512:$dst, (v16i32 (X86VBroadcastld32 addr:$src)))]>;
+def KNC_BCST_SD : KNC_P<(outs VR512:$dst), (ins f64mem:$src),
+                        [(set VR512:$dst, (v8f64 (X86VBroadcastld64 addr:$src)))]>;
+def KNC_BCST_Q : KNC_P<(outs VR512:$dst), (ins i64mem:$src),
+                       [(set VR512:$dst, (v8i64 (X86VBroadcastld64 addr:$src)))]>;
+}
+
+// kortest k1, k2: ZF = no bit set in k1 | k2, CF = every bit set (327364
+// section 6, KORTEST). LowerINTRINSIC_WO_CHAIN turns llvm.x86.knc.kortestz
+// and kortestc into this node and a SETCC, which a branch folds into jcc.
+def X86knc_kortest : SDNode<"X86ISD::KNC_KORTEST",
+                            SDTypeProfile<1, 2, [SDTCisVT<0, i32>,
+                                                 SDTCisVT<1, i16>,
+                                                 SDTCisVT<2, i16>]>>;
+let Predicates = [HasKNC], isPseudo = 1, isCodeGenOnly = 1,
+    hasSideEffects = 0, Defs = [EFLAGS], SchedRW = [WriteALU] in
+def KNC_KORTEST_P : KNC_P<(outs), (ins VK16:$a, VK16:$b), []>;
+let Predicates = [HasKNC] in
+def : Pat<(X86knc_kortest GR16:$a, GR16:$b),
+          (KNC_KORTEST_P
+             (COPY_TO_REGCLASS (i32 (INSERT_SUBREG (i32 (IMPLICIT_DEF)), GR16:$a, sub_16bit)), VK16),
+             (COPY_TO_REGCLASS (i32 (INSERT_SUBREG (i32 (IMPLICIT_DEF)), GR16:$b, sub_16bit)), VK16))>;
+
+// The MVEX.E/SSS immediate of an intrinsic when it is 0 (no decoration):
+// only then may a register form take its operand from memory instead
+// (X86InstrKNCIntrin.td, the folded loads).
+def knc_sss0 : TImmLeaf<i32, [{ return Imm == 0; }]>;
+
+// A zmm spill or reload where the slot is not 64-byte aligned (the stack can
+// no longer be realigned once register allocation has started): KNC has no
+// unaligned full-width move, so it is the unaligned pair, vpackstoreld and
+// vpackstorehd, or vloadunpackld and vloadunpackhd, the second 64 bytes on
+// (327364 section 2.1.3.2). Expanded after register allocation.
+let Predicates = [HasKNC], isPseudo = 1, isCodeGenOnly = 1,
+    hasSideEffects = 0 in {
+let mayStore = 1, SchedRW = [WriteFStoreY] in
+def KNC_SPILL_ZU : KNC_P<(outs), (ins f512mem:$dst, VR512:$src), []>;
+let mayLoad = 1, SchedRW = [WriteFLoadY] in
+def KNC_RELOAD_ZU : KNC_P<(outs VR512:$dst), (ins f512mem:$src), []>;
+}
