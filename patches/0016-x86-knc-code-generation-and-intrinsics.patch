+static void promoteKNCMaskPHIs(MachineFunction &MF) {
+  MachineRegisterInfo &MRI = MF.getRegInfo();
+  const TargetInstrInfo &TII = *MF.getSubtarget().getInstrInfo();
+  SmallVector<MachineInstr *, 8> PHIs;
+  for (MachineBasicBlock &MBB : MF)
+    for (MachineInstr &MI : MBB.phis())
+      if (MRI.getRegClass(MI.getOperand(0).getReg()) == &X86::GR16RegClass)
+        PHIs.push_back(&MI);
+  // A web: the GR16 PHIs connected through their operands. Each must have
+  // only k-register sources, constants or web PHIs coming in, and only
+  // k-register copies or web PHIs going out.
+  SmallPtrSet<MachineInstr *, 8> Done;
+  for (MachineInstr *Seed : PHIs) {
+    if (Done.count(Seed))
+      continue;
+    SmallSetVector<MachineInstr *, 8> Web;
+    SmallVector<MachineInstr *, 8> Work{Seed};
+    bool OK = true;
+    SmallVector<MachineInstr *, 8> Copies;
+    while (!Work.empty() && OK) {
+      MachineInstr *P = Work.pop_back_val();
+      if (!Web.insert(P))
+        continue;
+      for (unsigned I = 1; I < P->getNumOperands() && OK; I += 2) {
+        Register R = P->getOperand(I).getReg();
+        MachineInstr *D = MRI.getVRegDef(R);
+        if (D && D->isPHI() && MRI.getRegClass(R) == &X86::GR16RegClass)
+          Work.push_back(D);
+        else if (!kncMaskSource(MRI, R) && !(D && D->getOpcode() == X86::MOV16ri))
+          OK = false;
+      }
+      for (MachineInstr &U : MRI.use_nodbg_instructions(P->getOperand(0).getReg())) {
+        if (U.isPHI())
