+
+/// Expand KNC_SPILL_K and KNC_RELOAD_K after register allocation: kmov
+/// through a 32-bit general purpose register that is free here. Only
+/// caller-saved registers are tried, so no callee-saved register the
+/// prologue did not save is touched. With none free, %rax is kept in the
+/// scratch slot meanwhile.
+/// Expand KNC_SPILL_ZU and KNC_RELOAD_ZU: a zmm spill slot that is not
+/// 64-byte aligned is written by vpackstoreld and vpackstorehd and read by
+/// vloadunpackld and vloadunpackhd, the second of each 64 bytes on; the
+/// high half of a load keeps what the low half wrote.
+static bool expandKNCUnalignedSpill(MachineInstr &MI, const X86InstrInfo &TII) {
+  MachineBasicBlock &MBB = *MI.getParent();
+  const DebugLoc &DL = MI.getDebugLoc();
+  bool IsStore = MI.getOpcode() == X86::KNC_SPILL_ZU;
+  unsigned MemIdx = IsStore ? 0 : 1;
+  Register Z = MI.getOperand(IsStore ? X86::AddrNumOperands : 0).getReg();
+  for (int Half = 0; Half != 2; ++Half) {
+    unsigned Opc = IsStore ? (Half ? X86::KNC_VPACKSTOREHD_mz : X86::KNC_VPACKSTORELD_mz)
+                           : (Half ? X86::KNC_VLOADUNPACKHD_zm : X86::KNC_VLOADUNPACKLD_zm);
+    MachineInstrBuilder B = IsStore ? BuildMI(MBB, MI, DL, TII.get(Opc))
+                                    : BuildMI(MBB, MI, DL, TII.get(Opc), Z);
+    if (!IsStore)
+      B.addReg(X86::K0, RegState::Undef);
+    for (unsigned I = 0; I != X86::AddrNumOperands; ++I) {
+      const MachineOperand &MO = MI.getOperand(MemIdx + I);
+      if (I == X86::AddrDisp && Half)
+        B.addImm(MO.getImm() + 64);
+      else
+        B.add(MO);
+    }
+    if (IsStore)
+      B.addReg(X86::K0, RegState::Undef)
+          .addReg(Z, getKillRegState(Half && MI.getOperand(X86::AddrNumOperands).isKill()));
+    B.addImm(0).cloneMemRefs(MI);
+    if (!IsStore && Half)
+      B.addReg(Z, RegState::Implicit);
+  }
+  MI.eraseFromParent();
+  return true;
+}
+
+static bool expandKNCMaskSpill(MachineInstr &MI, const X86InstrInfo &TII) {
+  MachineBasicBlock &MBB = *MI.getParent();
+  MachineFunction &MF = *MBB.getParent();
+  const MachineRegisterInfo &MRI = MF.getRegInfo();
+  const TargetRegisterInfo &TRI = TII.getRegisterInfo();
+  const DebugLoc &DL = MI.getDebugLoc();
+  bool IsStore = MI.getOpcode() == X86::KNC_SPILL_K;
+  // KNC_SPILL_K: mem(0-4) src(5) scratch(6-10);
+  // KNC_RELOAD_K: dst(0) mem(1-5) scratch(6-10).
+  unsigned MemIdx = IsStore ? 0 : 1;
+  const MachineOperand &KOp = MI.getOperand(IsStore ? 5 : 0);
+  Register K = KOp.getReg();
+
+  Register Free;
+  if (MRI.tracksLiveness()) {
+    LivePhysRegs LPR(TRI);
+    LPR.addLiveOuts(MBB);
+    for (MachineInstr &I : llvm::reverse(MBB)) {
+      LPR.stepBackward(I);
+      if (&I == &MI)
+        break;
+    }
+    for (MCRegister R : {X86::EAX, X86::ECX, X86::EDX, X86::ESI, X86::EDI,
+                         X86::R8D, X86::R9D, X86::R10D, X86::R11D})
+      if (LPR.available(MRI, R)) {
+        Free = R;
+        break;
+      }
+  }
+  Register R32 = Free ? Free : Register(X86::EAX);
+  Register R16 = TRI.getSubReg(R32, X86::sub_16bit);
+  assert(MI.getOperand(MemIdx + X86::AddrBaseReg).getReg() != X86::RAX &&
+         "KNC mask spill slot addressed through %rax");
+
+  auto addMem = [&](MachineInstrBuilder B, unsigned Idx) {
+    for (unsigned I = 0; I != X86::AddrNumOperands; ++I)
+      B.add(MI.getOperand(Idx + I));
+    return B;
+  };
+  if (!Free)
+    addMem(BuildMI(MBB, MI, DL, TII.get(X86::MOV64mr)), 6).addReg(X86::RAX);
+  if (IsStore) {
+    BuildMI(MBB, MI, DL, TII.get(X86::KNC_KMOV_rk), R32)
+        .addReg(K, getKillRegState(KOp.isKill()));
+    addMem(BuildMI(MBB, MI, DL, TII.get(X86::MOV16mr)), MemIdx)
+        .addReg(R16, RegState::Kill)
+        .cloneMemRefs(MI);
+  } else {
+    addMem(BuildMI(MBB, MI, DL, TII.get(X86::MOVZX32rm16), R32), MemIdx)
+        .cloneMemRefs(MI);
+    BuildMI(MBB, MI, DL, TII.get(X86::KNC_KMOV_kr), K)
+        .addReg(R32, RegState::Kill);
+  }
+  if (!Free)
+    addMem(BuildMI(MBB, MI, DL, TII.get(X86::MOV64rm), X86::RAX), 6);
+  MI.eraseFromParent();
+  return true;
+}
