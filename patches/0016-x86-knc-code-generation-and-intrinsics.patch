+  // operand-size prefix) and kmov.
+  for (MachineBasicBlock &MBB : MF)
+    for (MachineInstr &MI : llvm::make_early_inc_range(MBB)) {
+      if (MI.getOpcode() != X86::MOV16ri || !MI.getOperand(1).isImm())
+        continue;
+      SmallVector<MachineInstr *, 4> Copies;
+      bool OnlyMasks = !MRI.use_nodbg_empty(MI.getOperand(0).getReg());
+      for (MachineInstr &U : MRI.use_nodbg_instructions(MI.getOperand(0).getReg()))
+        if (!kncMaskUses(MRI, U, Copies))
