+namespace {
+/// How a Knights Corner pseudo (X86InstrKNCCodeGen.td, X86InstrKNCIntrin.td)
+/// becomes its MC def (X86InstrKNC.td): for each MC operand, the explicit
+/// pseudo operand it is (a tied pass-through is simply not named), -1 for
+/// k0 (the "no mask" mask) or -2 for an MVEX.E/SSS of 0.
+struct KNCPseudoMap {
+  unsigned Pseudo, MC, NumOps;
+  int Op[12];
+};
+const KNCPseudoMap KNCPseudoMaps[] = {
+    {X86::KNC_MOVZ_rr, X86::KNC_VMOVAPS_zz, 4, {0, -1, 1, -2}},
+    {X86::KNC_MOVZ_rm, X86::KNC_VMOVAPS_zm, 8, {0, -1, 1, 2, 3, 4, 5, -2}},
+    {X86::KNC_MOVZ_mr, X86::KNC_VMOVAPS_mz, 8, {0, 1, 2, 3, 4, -1, 5, -2}},
+    {X86::KNC_BCST_SS, X86::KNC_VBROADCASTSS_zm, 8, {0, -1, 1, 2, 3, 4, 5, -2}},
+    {X86::KNC_BCST_D, X86::KNC_VPBROADCASTD_zm, 8, {0, -1, 1, 2, 3, 4, 5, -2}},
+    {X86::KNC_BCST_SD, X86::KNC_VBROADCASTSD_zm, 8, {0, -1, 1, 2, 3, 4, 5, -2}},
+    {X86::KNC_BCST_Q, X86::KNC_VPBROADCASTQ_zm, 8, {0, -1, 1, 2, 3, 4, 5, -2}},
+    {X86::KNC_KORTEST_P, X86::KNC_KORTEST_kk, 2, {0, 1}},
+#include "X86KNCPseudos.inc"
+};
+} // namespace
+
+/// Lower a Knights Corner pseudo to its MC def. Returns false for every
+/// other opcode.
+static bool lowerKNCPseudo(const MachineInstr *MI, MCInst &OutMI,
+                           const X86MCInstLower &L) {
+  if (MI->getOpcode() == X86::KNC_SET0) {
+    // vpxord zmm1, zmm1, zmm1 (327364 section 6, VPXORD)
+    MCOperand R = MCOperand::createReg(MI->getOperand(0).getReg());
+    OutMI.setOpcode(X86::KNC_VPXORD_zzz);
+    OutMI.addOperand(R);
+    OutMI.addOperand(MCOperand::createReg(X86::K0));
+    OutMI.addOperand(R);
+    OutMI.addOperand(R);
+    OutMI.addOperand(MCOperand::createImm(0));
+    return true;
+  }
+  static const DenseMap<unsigned, const KNCPseudoMap *> Maps = [] {
+    DenseMap<unsigned, const KNCPseudoMap *> M;
+    for (const KNCPseudoMap &E : KNCPseudoMaps)
+      M[E.Pseudo] = &E;
+    return M;
+  }();
+  auto It = Maps.find(MI->getOpcode());
+  if (It == Maps.end())
+    return false;
+  const KNCPseudoMap &M = *It->second;
+  SmallVector<MCOperand, 12> Ops;
+  for (const MachineOperand &MO : MI->explicit_operands())
+    Ops.push_back(L.LowerMachineOperand(MI, MO));
+  OutMI.setOpcode(M.MC);
+  for (unsigned I = 0; I != M.NumOps; ++I) {
+    int S = M.Op[I];
+    if (S == -1)
+      OutMI.addOperand(MCOperand::createReg(X86::K0));
+    else if (S == -2)
+      OutMI.addOperand(MCOperand::createImm(0));
+    else
+      OutMI.addOperand(Ops[S]);
+  }
+  return true;
+}
+
 void X86MCInstLower::Lower(const MachineInstr *MI, MCInst &OutMI) const {
+  if (lowerKNCPseudo(MI, OutMI, *this))
+    return;
+
   OutMI.setOpcode(MI->getOpcode());
 
   for (const MachineOperand &MO : MI->operands())
