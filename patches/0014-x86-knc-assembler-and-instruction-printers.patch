+/// Parse one {...} decoration of a Knights Corner operand: a write mask
+/// ({%k1}, {k1}) into Mask, anything else ({cdab}, {1to16}, {float16},
+/// {rn-sae}, {eh}) into Tok as written, braces included, in lower case.
+bool X86AsmParser::parseKNCDecoration(std::string &Tok, MCRegister &Mask,
+                                      SMLoc &Loc) {
+  MCAsmParser &Parser = getParser();
+  Loc = consumeToken(); // '{'
+  Tok.clear();
+  Mask = MCRegister();
+  StringRef Id = getLexer().is(AsmToken::Identifier)
+                     ? Parser.getTok().getIdentifier()
+                     : StringRef();
+  bool IsMask = getLexer().is(AsmToken::Percent) ||
+                (Id.size() == 2 && (Id[0] == 'k' || Id[0] == 'K') &&
+                 Id[1] >= '0' && Id[1] <= '7');
+  if (IsMask) {
+    SMLoc S, E;
+    if (parseRegister(Mask, S, E))
+      return true;
+    if (!getX86MCRegisterClass(X86::VK16RegClassID).contains(Mask))
+      return Error(S, "expected a mask register");
+  } else {
+    std::string T = "{";
+    while (getLexer().isNot(AsmToken::RCurly)) {
+      if (getLexer().is(AsmToken::EndOfStatement) ||
+          getLexer().is(AsmToken::Eof))
+        return Error(Loc, "expected '}'");
+      T += Parser.getTok().getString().lower();
+      Parser.Lex();
+    }
+    Tok = T + "}";
+  }
+  if (getLexer().isNot(AsmToken::RCurly))
+    return Error(Parser.getTok().getLoc(), "expected '}'");
+  Parser.Lex();
+  return false;
+}
+
+/// Parse and match a Knights Corner instruction. The operands are parsed
+/// with the ordinary AT&T or Intel operand parsers, their {...} decorations
+/// here; the forms of the mnemonic in X86KNCInfo are tried in order and the
+/// first that takes the operands builds KNCInst.
+bool X86AsmParser::parseKNCInstruction(StringRef Name, SMLoc NameLoc,
+                                       OperandVector &Operands) {
+  MCAsmParser &Parser = getParser();
+  struct KOp {
+    std::unique_ptr<X86Operand> Op;
+    MCRegister Mask;
+    SmallVector<std::string, 2> Decos;
+  };
+  SmallVector<KOp, 5> Ops;
+  std::string Round; // a decoration on its own: {rn}, {rz-sae}, {sae}
+
+  std::string Lower = Name.lower();
+  StringRef Mnem = Lower;
+  int PseudoImm = -1;
+  if (X86KNC::lookupMnemonic(Lower).empty())
+    if (const X86KNC::PseudoOp *P = X86KNC::lookupPseudo(Lower)) {
+      Mnem = P->Base;
+      if (P->Imm != 0xff)
+        PseudoImm = P->Imm;
+    }
+
+  Operands.push_back(X86Operand::CreateToken(Name, NameLoc));
+  if (getLexer().isNot(AsmToken::EndOfStatement)) {
+    while (true) {
+      if (getLexer().is(AsmToken::LCurly)) {
+        MCRegister M;
+        SMLoc L;
+        if (parseKNCDecoration(Round, M, L))
+          return true;
+        if (M)
+          return Error(L, "unexpected write mask");
+      } else {
+        SMLoc Loc = Parser.getTok().getLoc();
+        SmallVector<std::unique_ptr<MCParsedAsmOperand>, 2> One;
+        if (isParsingIntelSyntax() ? parseIntelOperand(One, Name)
+                                   : parseATTOperand(One))
+          return true;
+        if (One.size() != 1)
+          return Error(Loc, "unexpected operand");
+        KOp K;
+        K.Op.reset(static_cast<X86Operand *>(One[0].release()));
+        if (!K.Op->isReg() && !K.Op->isMem() && !K.Op->isImm())
+          return Error(Loc, "unexpected operand");
+        while (getLexer().is(AsmToken::LCurly)) {
+          std::string T;
+          MCRegister M;
+          SMLoc L;
+          if (parseKNCDecoration(T, M, L))
+            return true;
+          if (M) {
+            if (K.Mask)
+              return Error(L, "more than one write mask");
+            K.Mask = M;
+          } else {
+            K.Decos.push_back(T);
+          }
+        }
+        Ops.push_back(std::move(K));
+      }
+      if (getLexer().isNot(AsmToken::Comma))
+        break;
+      Parser.Lex();
+    }
+    if (getLexer().isNot(AsmToken::EndOfStatement))
+      return TokError("unexpected token in argument list");
+  }
+  Parser.Lex(); // Consume the EndOfStatement.
+
+  // The table lists operands in Intel order.
+  if (!isParsingIntelSyntax())
+    std::reverse(Ops.begin(), Ops.end());
+
+  auto InClass = [&](unsigned RC, MCRegister R) {
+    return R && getX86MCRegisterClass(RC).contains(R);
+  };
+  ArrayRef<X86KNC::Insn> Forms = X86KNC::lookupMnemonic(Mnem);
+
+  auto Try = [&](const X86KNC::Insn &I, MCInst &Inst) -> bool {
+    unsigned NumParsed = I.NumOps - (PseudoImm >= 0 ? 1 : 0);
+    if (Ops.size() != NumParsed)
+      return false;
+    unsigned E = 0, SSS = 0;
+    bool HaveConv = false;
+    MCRegister Mask;
+    unsigned Tab = I.MemTab ? I.MemTab : I.Reg0Tab;
+    for (unsigned J = 0; J != I.NumOps; ++J) {
+      const X86KNC::OperandDesc &D = I.Ops[J];
+      if (J >= Ops.size()) { // the immediate of a pseudo-op
+        if (D.Kind != X86KNC::K_IMM)
+          return false;
+        continue;
+      }
+      const KOp &K = Ops[J];
+      const X86Operand &Op = *K.Op;
+      switch (D.Kind) {
+      case X86KNC::K_VR:
+        if (!Op.isReg() || !(InClass(X86::VR512RegClassID, Op.getReg()) ||
+                             ((D.Flags & X86KNC::F_HALF) &&
+                              InClass(X86::VR256XRegClassID, Op.getReg()))))
+          return false;
+        break;
+      case X86KNC::K_KR:
+        if (!Op.isReg() || !InClass(X86::VK16RegClassID, Op.getReg()))
+          return false;
+        break;
+      case X86KNC::K_GR32:
+        if (!Op.isReg() || !InClass(X86::GR32RegClassID, Op.getReg()))
+          return false;
+        break;
+      case X86KNC::K_GR64:
+        if (!Op.isReg() || !InClass(X86::GR64RegClassID, Op.getReg()))
+          return false;
+        break;
+      case X86KNC::K_MEM:
+      case X86KNC::K_M8:
+        if (!Op.isMem() || InClass(X86::VR512RegClassID, Op.getMemIndexReg()))
+          return false;
+        break;
+      case X86KNC::K_VSIB:
+        if (!Op.isMem() || !InClass(X86::VR512RegClassID, Op.getMemIndexReg()))
+          return false;
+        break;
+      case X86KNC::K_IMM:
+        if (!Op.isImm())
+          return false;
+        break;
+      }
+      if (K.Mask) {
+        if (!(D.Flags & X86KNC::F_MASK))
+          return false;
+        Mask = K.Mask;
+      }
+      for (const std::string &T : K.Decos) {
+        if (T == "{eh}") {
+          // On memory the eviction hint; on the register source of a
+          // load-op form MVEX.E = 1 as well (gas: %zmm3{eh}).
+          bool RegSrc = !I.isMemForm() && (D.Flags & X86KNC::F_CONV);
+          if (!(D.Flags & X86KNC::F_EH) && !RegSrc)
+            return false;
+          if (I.EH != 2 || E)
+            return false;
+          E = 1;
+          continue;
+        }
+        if (!(D.Flags & X86KNC::F_CONV) || HaveConv)
+          return false;
+        int S = X86KNC::findDeco(X86KNC::getDecoTable(Tab), T);
+        if (S < 0)
+          return false;
+        SSS = S;
+        HaveConv = true;
+      }
+    }
+    if (!Round.empty()) {
+      if (I.isMemForm() || !I.Reg1Tab || E)
+        return false;
+      const X86KNC::DecoTable &R = X86KNC::getDecoTable(I.Reg1Tab);
+      if (R.Valid == 0xff) {
+        // Static rounding (Intel 327364-001, table 2.14); {sae} alone is
+        // {rn-sae}. It replaces the swizzle, so the two do not mix.
+        int S = X86KNC::findDeco(R, Round);
+        if (S < 0 && Round == "{sae}")
+          S = 4;
+        if (S < 0 || HaveConv)
+          return false;
+        SSS = S;
+      } else {
+        // SAE only: MVEX.E = 1; SSS keeps a swizzle when one is written,
+        // else 100 (as gas encodes {sae} and {sae} with a swizzle).
+        if (Round != "{sae}")
+          return false;
+        if (!HaveConv)
+          SSS = 4;
+      }
+      E = 1;
+    }
+    if (I.EH != 2)
+      E = I.EH;
+    // vprefetch*/clevict* have a VEX and an MVEX form; the MVEX one only
+    // when its disp8*64 is shorter than the VEX disp32 (as gas chooses).
+    if (I.Ops[0].Kind == X86KNC::K_M8 && Forms.size() > 1) {
+      const X86Operand &M = *Ops[0].Op;
+      int64_t Disp;
+      bool Short = false;
+      MCRegister Base = M.getMemBaseReg();
+      if (Base && Base != X86::RIP && Base != X86::EIP &&
+          M.getMemDisp()->evaluateAsAbsolute(Disp))
+        Short = !isInt<8>(Disp) && Disp % 64 == 0 && isInt<8>(Disp / 64);
+      if (Short != bool(I.MVEX))
+        return false;
+    }
+
+    Inst.clear();
+    Inst.setOpcode(I.Opcode);
+    for (unsigned Pos = 0;;) {
+      if (int(Pos) == I.MaskMI) {
+        Inst.addOperand(MCOperand::createReg(Mask ? Mask : MCRegister(X86::K0)));
+        ++Pos;
+        continue;
+      }
+      if (int(Pos) == I.SSSMI) {
+        Inst.addOperand(MCOperand::createImm(E << 3 | SSS));
+        ++Pos;
+        continue;
+      }
+      unsigned J = 0;
+      while (J != I.NumOps && I.Ops[J].MI != Pos)
+        ++J;
+      if (J == I.NumOps)
+        break;
+      const X86KNC::OperandDesc &D = I.Ops[J];
+      if (J >= Ops.size()) {
+        Inst.addOperand(MCOperand::createImm(PseudoImm));
+        ++Pos;
+      } else if (D.Kind == X86KNC::K_MEM || D.Kind == X86KNC::K_VSIB ||
+                 D.Kind == X86KNC::K_M8) {
+        Ops[J].Op->addMemOperands(Inst, 5);
+        // DS is the default segment unless the base is RSP or RBP; gas
+        // drops an explicit ds: there, and so does the KNC path.
+        MCOperand &Seg = Inst.getOperand(Inst.getNumOperands() - 1);
+        MCRegister Base = Inst.getOperand(Inst.getNumOperands() - 5).getReg();
+        if (Seg.getReg() == X86::DS && Base != X86::RSP && Base != X86::RBP &&
+            Base != X86::ESP && Base != X86::EBP)
+          Seg.setReg(MCRegister());
+        Pos += 5;
+      } else if (D.Kind == X86KNC::K_IMM) {
+        Ops[J].Op->addImmOperands(Inst, 1);
+        ++Pos;
+      } else {
+        MCRegister R = Ops[J].Op->getReg();
+        if (InClass(X86::VR256XRegClassID, R)) // a half source: zmm in MCInst
+          R = getX86MCRegisterClass(X86::VR512RegClassID)
+                  .getRegister(getContext().getRegisterInfo()->getEncodingValue(R));
+        Inst.addOperand(MCOperand::createReg(R));
+        ++Pos;
+      }
+    }
+    return true;
+  };
+
+  for (const X86KNC::Insn &I : Forms) {
+    MCInst Inst;
+    if (Try(I, Inst)) {
+      KNCInst = Inst;
+      HasKNCInst = true;
+      return false;
+    }
+  }
+  return Error(NameLoc, "invalid operands for Knights Corner instruction '" +
+                            Lower + "'");
+}
