+/// Print a Knights Corner instruction from its X86KNCInfo row: operands in
+/// Intel order (reversed for AT&T), the write mask and the swizzle or
+/// conversion on the operands that carry them, {eh} on memory, and the
+/// rounding or SAE decoration on its own (first in AT&T, last in Intel).
+/// What it prints assembles back to the same bytes.
+bool X86InstPrinterCommon::printKNCInst(const MCInst *MI, raw_ostream &OS,
+                                        bool Intel) {
+  const X86KNC::Insn *I = X86KNC::lookupOpcode(MI->getOpcode());
+  if (!I)
+    return false;
+  unsigned Bits = X86KNC::getMVEXBits(*MI);
+  bool E = I->EH == 2 && (Bits >> 3 & 1); // a fixed E is in the mnemonic
+  unsigned SSS = Bits & 7;
+  StringRef Mnem = I->Mnemonic;
+  unsigned NumOps = I->NumOps;
+  if (NumOps && I->Ops[NumOps - 1].Kind == X86KNC::K_IMM) {
+    const MCOperand &Imm = MI->getOperand(I->Ops[NumOps - 1].MI);
+    if (Imm.isImm())
+      if (const X86KNC::PseudoOp *P = X86KNC::findPseudo(Mnem, Imm.getImm())) {
+        Mnem = P->Pseudo;
+        --NumOps;
+      }
+  }
+
+  // The decorations.
+  bool RegForm = !I->isMemForm();
+  std::string Round, Conv;
+  bool RegEH = false, MemEH = false;
+  if (I->SSSMI >= 0) {
+    const X86KNC::DecoTable &T =
+        X86KNC::getDecoTable(I->MemTab ? I->MemTab : I->Reg0Tab);
+    auto Swizzle = [&](bool ShowDefault) -> std::string {
+      if (!SSS)
+        return ShowDefault && T.Alias[0] ? T.Alias : "";
+      return T.Tok[SSS];
+    };
+    if (RegForm && E) {
+      const X86KNC::DecoTable *R =
+          I->Reg1Tab ? &X86KNC::getDecoTable(I->Reg1Tab) : nullptr;
+      if (R && R->Valid == 0xff) {
+        Round = R->Tok[SSS];
+      } else if (R) {
+        // SAE only: SSS 100 is plain {sae}; anything else is a swizzle
+        // written next to it ({dcba} for 000).
+        Round = "{sae}";
+        if (SSS != 4)
+          Conv = Swizzle(true);
+      } else {
+        RegEH = true; // MVEX.E on a register source: %zmm3{eh}
+        Conv = Swizzle(false);
+      }
+    } else {
+      Conv = Swizzle(false);
+      MemEH = E;
+    }
+  }
+
+  OS << '\t' << Mnem;
+  bool First = true;
+  auto Sep = [&] {
+    OS << (First ? "\t" : ", ");
+    First = false;
+  };
+  if (!Intel && !Round.empty()) {
+    Sep();
+    OS << Round;
+  }
+  for (unsigned K = 0; K != NumOps; ++K) {
+    unsigned J = Intel ? K : NumOps - 1 - K;
+    const X86KNC::OperandDesc &D = I->Ops[J];
+    Sep();
+    switch (D.Kind) {
+    case X86KNC::K_MEM:
+    case X86KNC::K_VSIB:
+    case X86KNC::K_M8:
+      printKNCMemReference(MI, D.MI, OS);
+      break;
+    case X86KNC::K_VR:
+      if (D.Flags & X86KNC::F_HALF) {
+        MCRegister Reg = MI->getOperand(D.MI).getReg();
+        printRegName(OS, MRI.getRegClass(X86::VR256XRegClassID)
+                             .getRegister(MRI.getEncodingValue(Reg)));
+        break;
+      }
+      [[fallthrough]];
+    default:
+      printOperand(MI, D.MI, OS);
+      break;
+    }
+    if ((D.Flags & X86KNC::F_CONV) && !Conv.empty())
+      OS << Conv;
+    if (D.Flags & X86KNC::F_CONV && RegEH)
+      OS << "{eh}";
+    if ((D.Flags & X86KNC::F_EH) && MemEH && D.Kind != X86KNC::K_VR)
+      OS << "{eh}";
+    if ((D.Flags & X86KNC::F_MASK) && I->MaskMI >= 0) {
+      MCRegister Mask = MI->getOperand(I->MaskMI).getReg();
+      if (Mask && Mask != X86::K0) {
+        OS << " {";
+        printRegName(OS, Mask);
+        OS << '}';
+      }
+    }
+  }
+  if (Intel && !Round.empty()) {
+    Sep();
+    OS << Round;
+  }
+  return true;
+}
